
import java.util.Scanner;
class Main {
    public static void main(String[] args) {
        int n1,n2,c;
        Scanner sc = new Scanner(System.in);
        System.out.println("enter the start:");
        n1 = sc.nextInt();
        System.out.println("enter the limit:");
        n2 = sc.nextInt();
        c=0;
        for(int i=n1;i<=n2;i++){
            c=0;
            if (i>1){
                for(int j=1;j<=i;j++){
                    if (i%j==0){
                        c+=1;
                    }
                }
                if (c==2){
                    System.out.println("prime:"+i);
                }
            }
        }
    }
}
