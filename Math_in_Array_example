import java.util.Scanner;

public class Array {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int num[][]= new int[4][3];
        
        for(int i=0;i<4;i++){
            for(int j=0;j<3;j++){

                num[i][j] = (int)(Math.random()*100);

            }

        }
        for(int i=0;i<4;i++){
            for(int j=0;j<3;j++){
                System.out.print(num[i][j]+" ");
            }
            System.out.println();

        }
        
}
}

