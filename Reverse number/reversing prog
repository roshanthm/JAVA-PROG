import java.util.Scanner;

class Reverse {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n, r = 0;

        System.out.print("Enter the number to be reversed: ");
        n = sc.nextInt();

        while(n != 0) {
            int digit = n % 10;
            r = r * 10 + digit;
            n = n / 10;
        }

        System.out.println("Reversed number: " + r);
    }
}
